# Supabase(Settings → API から取得)
# anon キーはブラウザに露出する前提の公開鍵。RLS で保護する。
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ※ service_role キーと Resend API キーはここに書かない。
#    サーバー側(Vercel の環境変数画面)にのみ登録すること。

# パスワード再設定メールの戻り先。
# Web のみなら未設定でよい(現在のオリジンを使う)。
# ネイティブアプリでは Universal Links / App Links を張った https URL を指定する。
VITE_PASSWORD_RESET_URL=https://example.jp/reset-password
